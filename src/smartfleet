<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartFleet AI</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="topbar">
    <div>
      <h1>SmartFleet AI</h1>
      <p>Supply Chain Disruption Assistant & Fleet Utilisation Optimizer</p>
    </div>
    <div class="status">● AI SYSTEM ONLINE</div>
  </header>

  <nav class="nav">
    <button class="nav-btn active" data-page="dashboard">Dashboard</button>
    <button class="nav-btn" data-page="fleet">Fleet</button>
    <button class="nav-btn" data-page="disruptions">Disruptions</button>
    <button class="nav-btn" data-page="optimisation">AI Optimisation</button>
    <button class="nav-btn" data-page="assistant">AI Assistant</button>
  </nav>

  <main>
    <section id="dashboard" class="page active">
      <div class="hero">
        <div>
          <span class="eyebrow">LOGISTICS INTELLIGENCE</span>
          <h2>Make faster fleet decisions.</h2>
          <p>Monitor utilisation, understand disruptions and act on AI-generated recommendations.</p>
        </div>
        <button class="primary" onclick="generateRecommendation()">Generate AI Recommendation</button>
      </div>

      <div id="kpis" class="grid four"></div>

      <div class="grid two">
        <div class="card">
          <div class="card-title"><h3>Fleet Utilisation</h3><span>Live sample data</span></div>
          <div id="utilisationChart"></div>
        </div>
        <div class="card">
          <div class="card-title"><h3>Active Disruptions</h3><span>Priority alerts</span></div>
          <div id="alertList"></div>
        </div>
      </div>

      <div class="card recommendation-card">
        <div class="card-title"><h3>🤖 AI Recommendation</h3><span id="recommendationTime">Ready</span></div>
        <div id="recommendation">Click “Generate AI Recommendation” to analyse the current fleet and disruptions.</div>
      </div>
    </section>

    <section id="fleet" class="page">
      <div class="page-heading"><h2>Fleet Management</h2><p>Vehicle capacity, load and utilisation.</p></div>
      <div class="card table-wrap">
        <table>
          <thead><tr><th>Vehicle</th><th>Capacity</th><th>Load</th><th>Utilisation</th><th>Location</th><th>Status</th></tr></thead>
          <tbody id="fleetTable"></tbody>
        </table>
      </div>
    </section>

    <section id="disruptions" class="page">
      <div class="page-heading"><h2>Disruption Centre</h2><p>Identify disruption severity and affected routes.</p></div>
      <div id="disruptionCards" class="grid two"></div>
    </section>

    <section id="optimisation" class="page">
      <div class="page-heading"><h2>AI Fleet Optimisation</h2><p>Recommended reassignment based on availability, capacity and utilisation.</p></div>
      <div class="card">
        <div class="form-row">
          <label>Delivery
            <select id="deliverySelect"></select>
          </label>
          <button class="primary" onclick="optimiseSelectedDelivery()">Optimise Assignment</button>
        </div>
      </div>
      <div id="optimisationResult" class="card result-card">Select a delivery and run optimisation.</div>
    </section>

    <section id="assistant" class="page">
      <div class="page-heading"><h2>AI Assistant</h2><p>Ask questions about the current sample logistics data.</p></div>
      <div class="card chat">
        <div id="chatMessages" class="messages">
          <div class="message bot">Hello! Ask me about underutilised vehicles, disruptions, delayed deliveries or recommendations.</div>
        </div>
        <div class="chat-input">
          <input id="question" placeholder="Example: Which vehicles are underutilised?">
          <button class="primary" onclick="askAssistant()">Ask AI</button>
        </div>
        <div class="quick">
          <button onclick="quickAsk('Which vehicles are underutilised?')">Underutilised vehicles</button>
          <button onclick="quickAsk('Which deliveries are affected?')">Affected deliveries</button>
          <button onclick="quickAsk('What should I do about the disruption?')">Recommended action</button>
        </div>
      </div>
    </section>
  </main>

  <footer>SmartFleet AI • IBM BoB AI Innovation Hackathon 2026 Prototype</footer>
  <script src="app.js"></script>
</body>
</html>

